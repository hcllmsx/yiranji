{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "以苒纪",
  "version": "26.10.26",
  "identifier": "com.yiranji.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "以苒纪",
        "width": 1104,
        "height": 621,
        "minWidth": 1104,
        "minHeight": 621,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "莫莫先生",
    "copyright": "© 2026 莫莫先生",
    "resources": {
      "resources/sample-family": "sample-family"
    },
    "fileAssociations": [
      {
        "ext": [
          "yrp"
        ],
        "name": "Yiranji.Project",
        "description": "以苒纪工程文件",
        "mimeType": "application/vnd.yiranji.project"
      },
      {
        "ext": [
          "yrj"
        ],
        "name": "Yiranji.Package",
        "description": "以苒纪文件包",
        "mimeType": "application/vnd.yiranji.package"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
